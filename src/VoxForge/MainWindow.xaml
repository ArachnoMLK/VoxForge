<Window x:Class="VoxForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxForge" Width="1340" Height="900" MinWidth="1040" MinHeight="680"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Window.Resources>
        <!-- Logo: an ember tile holding a sound wave struck like an anvil spark -->
        <DrawingImage x:Key="LogoImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource EmberGradient}" Geometry="M8,0 H40 A8,8 0 0 1 48,8 V40 A8,8 0 0 1 40,48 H8 A8,8 0 0 1 0,40 V8 A8,8 0 0 1 8,0 Z"/>
                    <GeometryDrawing Geometry="M7,26 L13,26 L16,17 L20,35 L24,10 L28,38 L32,19 L35,26 L41,26">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1A1006" Thickness="3.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFF4E0" Geometry="M38,6 L39.5,10 L43.5,11.5 L39.5,13 L38,17 L36.5,13 L32.5,11.5 L36.5,10 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Board tabs -->
        <Style x:Key="BoardTab" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="0,0,8,8" CornerRadius="15" Padding="14,6"
                                Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7A4A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#2E2420"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.Icon>
        <StaticResource ResourceKey="LogoImage"/>
    </Window.Icon>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="8,4,8,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{StaticResource LogoImage}" Width="44" Height="44"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="VoxForge" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Forge ta voix en temps réel" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border CornerRadius="12" Background="{StaticResource PanelBrush}" Padding="12,6" Margin="0,0,14,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="À l'arrêt" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="460" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="▶  Démarrer" Click="OnStartStop" MinWidth="150"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Devices and levels -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Appareils" Style="{StaticResource SectionTitle}"/>
                            <Button Content="⟳ Actualiser" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,4" FontSize="12" Click="OnRefreshDevices"/>
                        </Grid>

                        <TextBlock Text="Microphone" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="MicCombo" SelectionChanged="OnDeviceChanged"/>

                        <TextBlock Text="Sortie vers Discord / jeux / OBS (câble virtuel)" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="OutputCombo" SelectionChanged="OnDeviceChanged"/>
                        <TextBlock x:Name="CableHint" Style="{StaticResource Hint}"/>

                        <CheckBox x:Name="MonitorCheck" Content="M'écouter dans le casque" Margin="0,18,0,0"
                                  Checked="OnDeviceChanged" Unchecked="OnDeviceChanged"/>
                        <ComboBox x:Name="MonitorCombo" Margin="0,8,0,0" SelectionChanged="OnDeviceChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Utilise un casque : avec des haut-parleurs, le micro réentend sa propre voix et ça siffle."/>

                        <TextBlock Text="Niveaux" Style="{StaticResource SectionTitle}" Margin="0,24,0,4"/>
                        <TextBlock Text="Entrée (micro)" Style="{StaticResource Label}"/>
                        <ProgressBar x:Name="InputMeter"/>
                        <TextBlock Text="Sortie (voix forgée)" Style="{StaticResource Label}"/>
                        <ProgressBar x:Name="OutputMeter"/>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="Gain du micro" Style="{StaticResource Label}" Margin="0"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                       Text="{Binding Value, ElementName=GainSlider, StringFormat={}{0:P0}}"/>
                        </Grid>
                        <Slider x:Name="GainSlider" Minimum="0" Maximum="3" Value="1" Margin="0,4,0,0" ValueChanged="OnGainChanged"/>
                        <CheckBox x:Name="MuteCheck" Content="Couper le micro" Margin="0,12,0,0" Checked="OnMuteChanged" Unchecked="OnMuteChanged"/>

                        <TextBlock Text="Raccourcis" Style="{StaticResource SectionTitle}" Margin="0,24,0,4"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="Ils marchent partout, même en jeu. Clic droit sur une voix ou un son pour lui donner un raccourci."/>
                        <ItemsControl x:Name="ActionHotkeys">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5"/>
                                        <Button Grid.Column="1" Content="{Binding ButtonText}" MinWidth="104" Padding="8,4" FontSize="12"
                                                Margin="8,0,0,0" Click="OnEditActionHotkey" ToolTip="Clique pour changer"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Fenêtre" Style="{StaticResource SectionTitle}" Margin="0,24,0,8"/>
                        <CheckBox x:Name="TrayCheck" Content="Fermer = rester en arrière-plan" Checked="OnTrayOptionChanged" Unchecked="OnTrayOptionChanged"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="La croix cache VoxForge dans la zone de notification (flèche en bas à droite) : ta voix continue. Clic droit sur l'icône pour quitter."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Voices and effects -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Voix" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Content="Tout désactiver" Padding="10,4" FontSize="12" Margin="0,0,16,0" Click="OnClearEffects"/>
                                    <CheckBox x:Name="EffectsCheck" Content="Effets activés" VerticalAlignment="Center"
                                              IsChecked="True" Checked="OnEffectsMasterChanged" Unchecked="OnEffectsMasterChanged"/>
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="PresetList" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource PresetItem}" SelectionChanged="OnPresetChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Background="Transparent">
                                            <StackPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Assigner un raccourci…" Click="OnEditVoiceHotkey"/>
                                                    <MenuItem Header="Retirer le raccourci" Click="OnClearVoiceHotkey"/>
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                            <Grid>
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding HotkeyText}" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,1,0,0"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Effets" Style="{StaticResource SectionTitle}" Margin="0,14,0,4"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Une voix règle ces effets pour toi. Tu peux ensuite tout ajuster, et combiner autant d'effets que tu veux."/>
                            <ItemsControl x:Name="EffectList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Bd" Width="250" Margin="0,0,10,10" CornerRadius="10" Padding="14,12"
                                                Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
                                            <StackPanel>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}"/>
                                                <ItemsControl x:Name="Knobs" ItemsSource="{Binding Params}" Opacity="0.45" Margin="0,2,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"/>
                                                                    <TextBlock Text="{Binding Display}" HorizontalAlignment="Right" Style="{StaticResource Label}"/>
                                                                </Grid>
                                                                <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}"
                                                                        TickFrequency="{Binding Step}" IsSnapToTickEnabled="{Binding Snaps}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Knobs" Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Soundboards -->
                <Border Grid.Row="1" Style="{StaticResource Card}" AllowDrop="True" Drop="OnDropSounds" DragOver="OnDragOverSounds">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Soundboards" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="Volume" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="SoundVolume" Width="120" Minimum="0" Maximum="1.5" Value="0.8" VerticalAlignment="Center" ValueChanged="OnSoundVolumeChanged"/>
                                <Button Content="■ Tout arrêter" Margin="14,0,0,0" Padding="12,6" Click="OnStopSounds"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="BoardList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ItemContainerStyle="{StaticResource BoardTab}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnBoardChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Clips.Count, StringFormat={} · {0}}" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="＋ Nouvelle soundboard" Padding="10,5" Click="OnNewBoard"/>
                                <Button Content="Importer un dossier" Padding="10,5" Margin="8,0,0,0" Click="OnImportFolder"/>
                                <Button x:Name="RenameBoardButton" Content="Renommer" Padding="10,5" Margin="8,0,0,0" Click="OnRenameBoard"/>
                                <Button x:Name="DeleteBoardButton" Content="Supprimer" Padding="10,5" Margin="8,0,0,0" Click="OnDeleteBoard"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Height="140" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SoundPads">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PadButton}" Click="OnPlaySound" ToolTip="{Binding Name}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Assigner un raccourci…" Click="OnEditPadHotkey"/>
                                                    <MenuItem Header="Retirer le raccourci" Click="OnClearPadHotkey"/>
                                                    <Separator/>
                                                    <MenuItem Header="Retirer ce son" Click="OnRemoveSound"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="100" MaxHeight="36"/>
                                                <TextBlock Text="{Binding HotkeyText}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Normal"
                                                           TextAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid>
                            <TextBlock x:Name="BoardHint" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                            <Button x:Name="AddSoundButton" Content="＋ Ajouter des sons" HorizontalAlignment="Right" Padding="12,6" Click="OnAddSound"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Margin="10,2,10,4" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                   Text="Dans Discord, OBS ou ton jeu, choisis « CABLE Output (VB-Audio Virtual Cable) » comme micro pour qu'ils entendent ta voix forgée."/>
    </Grid>
</Window>
