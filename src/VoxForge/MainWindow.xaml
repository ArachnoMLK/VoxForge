<Window x:Class="VoxForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoxForge"
        Title="VoxForge" Width="1280" Height="840" MinWidth="1000" MinHeight="640"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen"
        Closing="OnClosing" StateChanged="OnWindowStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Logo: an ember tile holding a sound wave struck like an anvil spark -->
        <DrawingImage x:Key="LogoImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource EmberGradient}" Geometry="M8,0 H40 A8,8 0 0 1 48,8 V40 A8,8 0 0 1 40,48 H8 A8,8 0 0 1 0,40 V8 A8,8 0 0 1 8,0 Z"/>
                    <GeometryDrawing Geometry="M7,26 L13,26 L16,17 L20,35 L24,10 L28,38 L32,19 L35,26 L41,26">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1A1006" Thickness="3.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFF4E0" Geometry="M38,6 L39.5,10 L43.5,11.5 L39.5,13 L38,17 L36.5,13 L32.5,11.5 L36.5,10 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Soundboard pad: playing pads glow and show their progress -->
        <Style x:Key="PadButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale"/>
                            </Grid.RenderTransform>
                            <Border CornerRadius="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                            <Border x:Name="Live" CornerRadius="12" Background="{StaticResource SelectedGradient}" BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1.5" Opacity="0"/>
                            <Border x:Name="Glow" CornerRadius="12" Background="{StaticResource HoverBrush}" Opacity="0"/>
                            <ContentPresenter Margin="12,10"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Live" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Live" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.Icon>
        <StaticResource ResourceKey="LogoImage"/>
    </Window.Icon>

    <Border x:Name="RootFrame">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar background spans the title row too -->
            <Border Grid.RowSpan="2" Background="{StaticResource SideBrush}"/>

            <!-- Title bar -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Image Source="{StaticResource LogoImage}" Width="22" Height="22"/>
                <TextBlock Text="VoxForge" FontWeight="Bold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Réduire"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Agrandir"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Fermer"/>
            </StackPanel>

            <!-- Sidebar -->
            <DockPanel Grid.Row="1" Grid.Column="0" Margin="14,10,14,16" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavVoices" Style="{StaticResource NavButton}" Tag="&#xE720;" Content="Voix" IsChecked="True" Checked="OnNavigate"/>
                    <RadioButton x:Name="NavEffects" Style="{StaticResource NavButton}" Tag="&#xE9E9;" Content="Effets" Checked="OnNavigate"/>
                    <RadioButton x:Name="NavSounds" Style="{StaticResource NavButton}" Tag="&#xE8D6;" Content="Soundboards" Checked="OnNavigate"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Réglages" Checked="OnNavigate"/>
                </StackPanel>

                <!-- Live panel -->
                <Border DockPanel.Dock="Bottom" CornerRadius="14" Background="{StaticResource PanelBrush}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="VOIX ACTUELLE" Foreground="{StaticResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentVoiceText" FontSize="17" FontWeight="Bold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   Text="{Binding SelectedItem.Name, ElementName=PresetList, FallbackValue='Réglage perso', TargetNullValue='Réglage perso'}"/>

                        <CheckBox x:Name="EffectsCheck" Content="Effets activés" Margin="0,14,0,0" IsChecked="True"
                                  Checked="OnEffectsMasterChanged" Unchecked="OnEffectsMasterChanged"/>
                        <CheckBox x:Name="MuteCheck" Content="Couper le micro" Margin="0,10,0,0" Checked="OnMuteChanged" Unchecked="OnMuteChanged"/>

                        <Grid Margin="0,16,0,5">
                            <TextBlock Text="Micro" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </Grid>
                        <ProgressBar x:Name="InputMeter"/>
                        <TextBlock Text="Voix forgée" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,5"/>
                        <ProgressBar x:Name="OutputMeter"/>

                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Click="OnStartStop" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StartIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13"/>
                                <TextBlock x:Name="StartLabel" Text="Démarrer" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Content -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="34,4,26,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,8,18">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Voix" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="PageSubtitle" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border x:Name="StatusPill" CornerRadius="15" Background="{StaticResource PanelBrush}" Padding="14,7"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusPulse" Fill="{StaticResource OkBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="PulseScale"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="StatusDot" Fill="{StaticResource MutedBrush}"/>
                            </Grid>
                            <TextBlock x:Name="StatusText" Text="À l'arrêt" Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="440" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Page: voices -->
                <ScrollViewer x:Name="PageVoices" Grid.Row="1" VerticalScrollBarVisibility="Auto" local:SmoothScroll.IsEnabled="True">
                    <StackPanel Margin="0,0,8,24">
                        <Grid>
                            <ListBox x:Name="CategoryList" Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}"
                                     SelectionChanged="OnCategoryChanged" Margin="0,0,200,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Count}" Margin="7,0,0,0" Opacity="0.65"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Voix naturelle" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="14,7" Click="OnClearEffects"
                                    ToolTip="Coupe tous les effets"/>
                        </Grid>

                        <ListBox x:Name="PresetList" Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource PresetItem}"
                                 SelectionChanged="OnPresetChanged" Margin="0,4,0,0">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,16,0,12">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                                <Border CornerRadius="9" Background="{StaticResource Panel2Brush}" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ItemCount}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Assigner un raccourci…" Click="OnEditVoiceHotkey"/>
                                                <MenuItem Header="Retirer le raccourci" Click="OnClearVoiceHotkey"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding HotkeyText}" Foreground="{StaticResource AccentBrush}" FontSize="10.5"
                                                   VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,0"
                                   Text="Clic droit sur une voix pour lui donner un raccourci clavier. Affine ensuite le rendu dans Effets."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page: effects -->
                <ScrollViewer x:Name="PageEffects" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" local:SmoothScroll.IsEnabled="True">
                    <StackPanel Margin="0,0,8,24">
                        <Grid Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,220,0" VerticalAlignment="Center"
                                       Text="Une voix règle ces effets pour toi. Ajuste-les ou combine-en autant que tu veux : ça s'entend tout de suite."/>
                            <Button Content="Tout désactiver" HorizontalAlignment="Right" Padding="14,7" Click="OnClearEffects"/>
                        </Grid>
                        <ItemsControl x:Name="EffectList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="270" Margin="0,0,14,14">
                                        <Border CornerRadius="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                                        <Border x:Name="On" CornerRadius="14" Background="{StaticResource SelectedGradient}" BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="1.5" Opacity="0"/>
                                        <StackPanel Margin="18,16">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                                <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}"/>
                                            <ItemsControl x:Name="Knobs" ItemsSource="{Binding Params}" Opacity="0.4" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"/>
                                                                <TextBlock Text="{Binding Display}" HorizontalAlignment="Right" Style="{StaticResource Label}" Foreground="{StaticResource TextBrush}"/>
                                                            </Grid>
                                                            <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}"
                                                                    TickFrequency="{Binding Step}" IsSnapToTickEnabled="{Binding Snaps}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetName="Knobs" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                                        <DoubleAnimation Storyboard.TargetName="Knobs" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.25"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page: soundboards -->
                <Grid x:Name="PageSounds" Grid.Row="1" Visibility="Collapsed" Margin="0,0,8,20" AllowDrop="True"
                      Drop="OnDropSounds" DragOver="OnDragOverSounds" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Board list -->
                    <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="12,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Mes soundboards" Style="{StaticResource SectionTitle}" Margin="6,0,0,10"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button HorizontalContentAlignment="Left" Click="OnNewBoard">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12"/>
                                        <TextBlock Text="Nouvelle soundboard" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="OnImportFolder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12"/>
                                        <TextBlock Text="Importer un dossier" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" local:SmoothScroll.IsEnabled="True">
                                <ListBox x:Name="BoardList" Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource RowItem}"
                                         SelectionChanged="OnBoardChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,28,0"/>
                                                <TextBlock Text="{Binding Clips.Count}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Pads -->
                    <DockPanel Grid.Column="1">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedItem.Name, ElementName=BoardList}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="RenameBoardButton" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnRenameBoard" ToolTip="Renommer">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13"/>
                                </Button>
                                <Button x:Name="DeleteBoardButton" Style="{StaticResource GhostButton}" Click="OnDeleteBoard" ToolTip="Supprimer la soundboard">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                                <Slider x:Name="SoundVolume" Width="110" Minimum="0" Maximum="1.5" Value="0.8" VerticalAlignment="Center" ValueChanged="OnSoundVolumeChanged"
                                        ToolTip="Volume des sons"/>
                                <Button Margin="14,0,0,0" Padding="12,7" Click="OnStopSounds" ToolTip="Arrêter tous les sons">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12"/>
                                        <TextBlock Text="Stop" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="AddSoundButton" Style="{StaticResource PrimaryButton}" Padding="16,8" FontSize="13" Click="OnAddSound">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12"/>
                                    <TextBlock Text="Ajouter des sons" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddLinkButton" Margin="10,0,0,0" Padding="14,8" Click="OnAddLink">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="12"/>
                                    <TextBlock Text="Ajouter depuis un lien" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border x:Name="DownloadPanel" DockPanel.Dock="Top" CornerRadius="12" Background="{StaticResource PanelBrush}" Padding="14,10"
                                Margin="0,0,0,14" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DownloadText" Text="Téléchargement…" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar x:Name="DownloadBar" Margin="0,8,0,0" Foreground="{StaticResource EmberGradient}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Annuler" Margin="14,0,0,0" Padding="12,6" Click="OnCancelDownload"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="BoardHint" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,10,0,0"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" local:SmoothScroll.IsEnabled="True">
                            <ItemsControl x:Name="SoundPads">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PadButton}" Click="OnPlaySound" ToolTip="{Binding Name}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Assigner un raccourci…" Click="OnEditPadHotkey"/>
                                                    <MenuItem Header="Retirer le raccourci" Click="OnClearPadHotkey"/>
                                                    <Separator/>
                                                    <MenuItem Header="Retirer ce son" Click="OnRemoveSound"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                                <Grid Grid.Row="1">
                                                    <TextBlock Text="{Binding HotkeyText}" Foreground="{StaticResource AccentBrush}" FontSize="10.5"/>
                                                    <ProgressBar Height="3" Margin="0,0,0,1" VerticalAlignment="Bottom" Value="{Binding PlayProgress, Mode=OneWay}"
                                                                 Foreground="{StaticResource EmberGradient}" Visibility="{Binding IsPlaying, Converter={StaticResource ShowIf}}"/>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- Page: settings -->
                <ScrollViewer x:Name="PageSettings" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" local:SmoothScroll.IsEnabled="True">
                    <Grid Margin="0,0,8,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Appareils" Style="{StaticResource SectionTitle}"/>
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0"
                                                Click="OnRefreshDevices" ToolTip="Actualiser la liste">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
                                                <TextBlock Text="Actualiser" Margin="8,0,0,0" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="Microphone" Style="{StaticResource Label}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="MicCombo" SelectionChanged="OnDeviceChanged"/>
                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Text="Gain du micro" Style="{StaticResource Label}" Margin="0"/>
                                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                   Text="{Binding Value, ElementName=GainSlider, StringFormat={}{0:P0}}"/>
                                    </Grid>
                                    <Slider x:Name="GainSlider" Minimum="0" Maximum="3" Value="1" Margin="0,4,0,0" ValueChanged="OnGainChanged"/>

                                    <TextBlock Text="Sortie vers Discord / jeux / OBS" Style="{StaticResource Label}" Margin="0,16,0,5"/>
                                    <ComboBox x:Name="OutputCombo" SelectionChanged="OnDeviceChanged"/>

                                    <CheckBox x:Name="MonitorCheck" Content="M'écouter dans le casque" Margin="0,20,0,0"
                                              Checked="OnDeviceChanged" Unchecked="OnDeviceChanged"/>
                                    <ComboBox x:Name="MonitorCombo" Margin="0,10,0,0" SelectionChanged="OnDeviceChanged"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Utilise un casque : avec des haut-parleurs, le micro réentend sa propre voix et ça siffle."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Câble virtuel" Style="{StaticResource SectionTitle}"/>
                                    <Border x:Name="CableBadge" CornerRadius="10" Padding="12,10" Background="{StaticResource Panel2Brush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="CableIcon" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="16" Foreground="{StaticResource WarnBrush}"/>
                                            <TextBlock x:Name="CableHint" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="380"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="Le câble virtuel (VB-Cable, gratuit) crée un faux micro « CABLE Output ». VoxForge joue ta voix forgée dedans, et Discord, OBS ou ton jeu l'écoutent comme un vrai micro."/>
                                    <StackPanel x:Name="CableSteps" Margin="0,12,0,0">
                                        <Button x:Name="InstallCableButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="16,9" FontSize="13"
                                                Click="OnInstallCable">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12"/>
                                                <TextBlock x:Name="InstallCableLabel" Text="Installer le câble virtuel" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                   Text="VoxForge télécharge l'installeur officiel de vb-audio.com et le lance. Windows te demande l'autorisation : clique Oui, puis « Install Driver ». Redémarre ensuite le PC."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Raccourcis" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                               Text="Ils marchent partout, même en jeu. Clic droit sur une voix ou un son pour lui en donner un."/>
                                    <ItemsControl x:Name="ActionHotkeys">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <Button Grid.Column="1" Content="{Binding ButtonText}" MinWidth="120" Padding="10,6" FontSize="12"
                                                            Margin="10,0,0,0" Click="OnEditActionHotkey" ToolTip="Clique pour changer"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Fenêtre" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox x:Name="TrayCheck" Content="Fermer = rester en arrière-plan" Checked="OnTrayOptionChanged" Unchecked="OnTrayOptionChanged"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="La croix cache VoxForge dans la zone de notification (flèche en bas à droite) : ta voix continue. Clic droit sur l'icône pour quitter."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
